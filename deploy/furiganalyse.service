[Unit]
Description=Furiganalyse web application
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/furiganalyse
Environment=PYTHONUNBUFFERED=1
Environment=FURIGANALYSE_CLEANUP_THRESHOLD_IN_MB=100
ExecStart=/root/furiganalyse/.venv/bin/uvicorn furiganalyse.app:app --host 127.0.0.1 --port 5000 --workers 1
Restart=on-failure
RestartSec=3
TimeoutStopSec=60
UMask=0077

[Install]
WantedBy=multi-user.target
